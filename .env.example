# Copy to .env and fill in. .env is gitignored — never commit real values.

# Supabase (Project Settings → API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
# service_role bypasses RLS — import script + refresh job only, never the browser
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud (Credentials → API key, restricted to Places API (New))
GOOGLE_MAPS_API_KEY=
